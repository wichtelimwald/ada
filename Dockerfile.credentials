# Credential-bearing Ada image. Deliberately separate from the VS Code / PoC
# targets: exactly the fully reviewed wheel graph is allowed at runtime.
#
# BUILD GATES: supply the reviewed python:3.14-slim@sha256:<64hex> base digest
# and commit requirements/ada-runtime-py314-linux-aarch64.txt first.
# No real credentials until independent security sign-off.
ARG ADA_PYTHON_BASE=python:3.14-slim
FROM ${ADA_PYTHON_BASE} AS credential-runtime
ARG ADA_PYTHON_BASE

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONNOUSERSITE=1 \
    PYDANTIC_AI_NO_BANNER=1 \
    ADA_REQUIRE_ISOLATED_CREDENTIALS=1

# Refuse tag-only bases even if they happen to point at valid Python today.
RUN python -c "import os,re,sys,platform; base=os.environ['ADA_PYTHON_BASE']; ok=bool(re.fullmatch(r'python:3[.]14-slim@sha256:[0-9a-f]{64}',base)); sys.exit(0 if ok and sys.version_info[:2]==(3,14) and platform.machine()=='aarch64' and sys.platform=='linux' else 'A reviewed Python 3.14 ARM64 image digest is required')"

RUN groupadd --gid 10001 ada \
    && useradd --uid 10001 --gid 10001 --create-home ada

WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
COPY requirements/ada-runtime-py314-linux-aarch64.txt ./requirements/
COPY scripts/check_credential_runtime_lock.py ./scripts/

# Every external runtime/build dependency is installed from a reviewed,
# hash-locked binary wheel. Installing Ada's OWN local source is offline,
# without dependency resolution and without build isolation; setuptools is
# already among the hash-verified wheels. No editable/source bind mount.
RUN python -m pip --isolated install --no-cache-dir --only-binary=:all: \
        --require-hashes -r /app/requirements/ada-runtime-py314-linux-aarch64.txt \
    && python -m pip --isolated install --no-index --no-deps \
        --no-build-isolation /app \
    && python -m pip check

# Fail closed on unexpected system-site distributions, wrong pinned versions
# or installed extras that could execute inside the credential process.
RUN python /app/scripts/check_credential_runtime_lock.py

LABEL org.ada.credential-runtime="locked-aarch64-v1"

USER 10001:10001
ENTRYPOINT ["python", "-I", "-m", "ada"]
CMD ["doctor"]
