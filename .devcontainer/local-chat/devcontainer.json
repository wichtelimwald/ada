{
  "name": "Ada local chat (Docker Desktop host networking)",
  "build": {
    "dockerfile": "../../Dockerfile",
    "context": "../..",
    "target": "development"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "workspaceFolder": "/workspace",
  "remoteUser": "ada",
  "containerEnv": {
    "PYDANTIC_AI_NO_BANNER": "1",
    "PYTHONPATH": "/workspace/src"
  },
  "runArgs": [
    "--network=host",
    "--cap-drop=ALL",
    "--security-opt=no-new-privileges",
    "--read-only",
    "--tmpfs=/tmp:rw,nosuid,noexec,uid=10001,gid=10001",
    "--tmpfs=/home/ada:rw,nosuid,uid=10001,gid=10001",
    "--pids-limit=256"
  ]
}
