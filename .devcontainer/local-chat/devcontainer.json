{
  "name": "Ada local chat (Docker Desktop host networking)",
  "build": {
    "dockerfile": "../../Dockerfile",
    "context": "../..",
    "target": "development"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "workspaceFolder": "/workspace",
  "remoteUser": "ada",
  "containerEnv": {
    "PYDANTIC_AI_NO_BANNER": "1"
  },
  "runArgs": [
    "--network=host",
    "--cap-drop=ALL",
    "--security-opt=no-new-privileges",
    "--pids-limit=256"
  ],
  "postCreateCommand": "sh ./scripts/validate.sh"
}
